FROM docker.io/library/gcc@sha256:213a0e383dc1429862a8f12624dfe8fb43339bc808a79f4e578529e4903b3054
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake python3 time pkg-config libboost-dev libx11-dev libxrandr-dev libxinerama-dev \
    libxcursor-dev libxi-dev libwayland-dev wayland-protocols libxkbcommon-dev \
    libgl1-mesa-dev libreadline-dev xvfb xauth && rm -rf /var/lib/apt/lists/*
# cli_shell currently resolves these libraries through Fedora's /usr/lib64 path.
RUN mkdir -p /usr/lib64 && \
    ln -s /usr/lib/$(dpkg-architecture -qDEB_HOST_MULTIARCH)/libreadline.so /usr/lib64/libreadline.so && \
    ln -s /usr/lib/$(dpkg-architecture -qDEB_HOST_MULTIARCH)/libhistory.so /usr/lib64/libhistory.so
